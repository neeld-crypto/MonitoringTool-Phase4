# Run Pulse in the background, start it at boot and bring it back if it stops or crashes.
#   1. edit User= and the two paths below
#   2. sudo cp playprobe.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   3. sudo systemctl enable --now playprobe        (logs: journalctl -u playprobe -f)
[Unit]
Description=Pulse stream monitor
After=network-online.target

[Service]
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/playprobe
Environment=HOST=0.0.0.0
# The sign-in of the page. Change both; admin / admin is only the fallback.
Environment=PULSE_USER=admin
Environment=PULSE_PASSWORD=CHANGE_ME
ExecStart=/home/CHANGE_ME/playprobe/start.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
