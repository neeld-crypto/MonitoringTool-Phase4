# Run Pulse in the background, start it at boot and bring it back if it stops or crashes.
#   1. edit User= and the two paths below
#   2. sudo cp playprobe.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   3. sudo systemctl enable --now playprobe        (logs: journalctl -u playprobe -f)
[Unit]
Description=Pulse stream monitor
After=network-online.target

[Service]
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/playprobe
Environment=HOST=0.0.0.0
# The sign-in of the page (these are also the built-in defaults).
Environment=PULSE_USER=Skandha
Environment=PULSE_PASSWORD=Skandha@123
# Slack alerts: remove the leading # and paste your Incoming Webhook URL, then
#   sudo systemctl daemon-reload && sudo systemctl restart playprobe
# Environment=SRT_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ
# Environment=SRT_WEBHOOK_KIND=slack
ExecStart=/home/CHANGE_ME/playprobe/start.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
