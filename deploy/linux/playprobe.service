# Optional: run PlayProbe in the background and start it at boot.
#   1. edit User= and the two paths below
#   2. sudo cp playprobe.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   3. sudo systemctl enable --now playprobe        (logs: journalctl -u playprobe -f)
[Unit]
Description=PlayProbe SRT / HLS monitor
After=network-online.target

[Service]
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/playprobe
ExecStart=/home/CHANGE_ME/playprobe/start.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
