{
  "name": "pulse",
  "version": "1.0.0",
  "private": true,
  "description": "Pulse: Express backend for the stream monitoring wall (SRT / UDP / HLS monitoring, alerts, CORS proxy). The React frontend is in ./frontend",
  "license": "MIT",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --watch-path=src server.js",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix frontend install",
    "test": "vitest run",
    "test:frontend": "npm --prefix frontend test",
    "build:exe": "node scripts/build-exe.mjs",
    "build:linux": "node scripts/build-linux.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^10.1.7",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
